{{- /* Legacy feed served at /blogs/index.xml (see outputFormats in hugo.yaml).
       Same items as /writing/index.xml, so old subscribers keep working. */ -}}
{{- $pages := where site.RegularPages "Section" "writing" -}}
{{- $section := site.GetPage "/writing" -}}
{{- printf `<?xml version="1.0" encoding="utf-8" standalone="yes"?>` | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ $section.Title }} on {{ site.Title }}</title>
    <link>{{ $section.Permalink }}</link>
    <description>Recent content in {{ $section.Title }} on {{ site.Title }}</description>
    <generator>Hugo</generator>
    <language>{{ site.LanguageCode }}</language>
    <managingEditor>{{ site.Params.author }}</managingEditor>
    <webMaster>{{ site.Params.author }}</webMaster>
    {{- with $pages }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "blogsrss" }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ partial "page-description.html" . | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
